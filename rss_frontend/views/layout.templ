package views

// PageParams carries the layout chrome.
type PageParams struct {
	Title       string
	User        string
	AuthEnabled bool
}

templ shell(p PageParams) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title } — The RSS Gazette</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script>
				(function(){try{var t=localStorage.getItem("rss-theme");if(!t){t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";}document.documentElement.setAttribute("data-theme",t);}catch(e){}})();
			</script>
			<script src="/static/js/htmx.min.js" defer></script>
			<script src="/static/js/alpine.min.js" defer></script>
		</head>
		<body>
			<div id="toasts" class="toasts" aria-live="polite"></div>
			<div class="paper">
				<header class="masthead">
					<div class="dateline"><span id="dateline">{ dateline() }</span></div>
					<h1 class="nameplate"><a href="/">The RSS Gazette</a></h1>
					<p class="tagline">All the news that fits the queue</p>
					<nav class="navrow">
						<a href="/" class="navlink">Front Page</a>
						<a href="/config" class="navlink">Configure</a>
						<a href="/status" class="navlink">Status</a>
						<span class="navspacer"></span>
						if p.AuthEnabled {
							if p.User != "" {
								<span class="navuser">{ p.User }</span>
								<a href="/auth/logout" class="navlink">Log out</a>
							} else {
								<a href="/auth/login" class="navlink">Log in</a>
							}
						}
						<button
							class="navlink themebtn"
							x-data
							@click="(function(){var h=document.documentElement;var n=h.getAttribute('data-theme')==='dark'?'light':'dark';h.setAttribute('data-theme',n);try{localStorage.setItem('rss-theme',n);}catch(e){}})()"
						>◐ theme</button>
					</nav>
				</header>
				<main>
					{ children... }
				</main>
				<footer class="colophon">
					<span>made with ♥ by FKouhai</span>
				</footer>
			</div>
			<script>
				document.getElementById("dateline").textContent = new Date().toLocaleDateString(undefined, {weekday:"long", year:"numeric", month:"long", day:"numeric"});
				window.rssRead = {
					key: "rss-read-items",
					list: function(){ try { return JSON.parse(localStorage.getItem(this.key) || "[]"); } catch(e){ return []; } },
					has: function(id){ return this.list().indexOf(id) !== -1; },
					mark: function(id){ var l = this.list(); if (l.indexOf(id) === -1) { l.push(id); try { localStorage.setItem(this.key, JSON.stringify(l.slice(-2000))); } catch(e){} } }
				};
				window.rssResetImportForm = function(){
					var f = document.querySelector('form[hx-post="/config/import"]');
					if(!f) return;
					f.reset();
					var lbl = f.querySelector('[data-filename]');
					if(lbl) lbl.textContent = "No file chosen";
				};
				window.rssToast = function(msg, isErr){
					var box = document.getElementById("toasts");
					if(!box) return;
					while(box.children.length >= 3){ box.removeChild(box.firstChild); }
					var t = document.createElement("div");
					t.className = "toast" + (isErr ? " error" : "");
					t.textContent = msg;
					box.appendChild(t);
					setTimeout(function(){ t.remove(); }, isErr ? 8000 : 6000);
				};
				// OOB-inserted toasts can't rely on Alpine init, so arm
				// their dismissal here: htmx fires this after every
				// out-of-band swap.
				document.body.addEventListener("htmx:oobAfterSwap", function(){
					var box = document.getElementById("toasts");
					if(!box) return;
					var nodes = box.querySelectorAll("[data-autodismiss]:not([data-armed])");
					for(var i = 0; i < nodes.length; i++){
						(function(el){
							el.setAttribute("data-armed", "1");
							var ms = parseInt(el.getAttribute("data-autodismiss"), 10) || 6000;
							setTimeout(function(){ el.remove(); }, ms);
						})(nodes[i]);
					}
				});
				document.body.addEventListener("htmx:responseError", function(e){
					var msg = "Request failed";
					try {
						var xhr = e.detail.xhr;
						msg = (xhr.responseText || ("Request failed (" + xhr.status + ")")).trim();
					} catch(_){}
					window.rssToast(msg, true);
					var path = "";
					try { path = e.detail.requestConfig.path; } catch(_){}
					if(path === "/config/import"){
						var p = document.getElementById("config-import-preview");
						if(p) p.innerHTML = "";
						window.rssResetImportForm();
					}
				});
				// A completed preview consumes the selection: reset the
				// file input so a stale filename doesn't linger.
				document.body.addEventListener("htmx:afterRequest", function(e){
					var ok = false, path = "";
					try { ok = e.detail.successful; path = e.detail.requestConfig.path; } catch(_){}
					if(!ok || path !== "/config/import") return;
					window.rssResetImportForm();
				});
			</script>
		</body>
	</html>
}

func dateline() string { return "" }
