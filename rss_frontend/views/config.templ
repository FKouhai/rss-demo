package views

templ Config(p ConfigParams) {
	@shell(PageParams{Title: p.Title, User: p.User, AuthEnabled: p.AuthEnabled}) {
		<h2 class="sectionhead">Configure</h2>
		if !p.ConfigOK {
			<div class="notice">
				<p>Config service unreachable — showing feeds observed by the aggregator (read-only).</p>
			</div>
			if !p.AggOK {
				<div class="notice">
					<p>Aggregator unreachable too — no feeds to show.</p>
				</div>
			}
			<h3 class="subhead">Feeds in store ({ itoa(len(p.Feeds)) })</h3>
			if len(p.Feeds) == 0 {
				<p class="muted">No feeds observed yet.</p>
			} else {
				<table class="ledger">
					<thead><tr><th>Feed</th></tr></thead>
					<tbody>
						for _, f := range p.Feeds {
							<tr><td><code>{ f }</code></td></tr>
						}
					</tbody>
				</table>
			}
		} else {
			<div class="notice">
				<p>Managed by the <code>rss_config</code> service — the poller polls this list. The default webhook applies where a feed sets no override.</p>
			</div>
			<h3 class="subhead">Default webhook</h3>
			if p.IsAdmin {
				<form class="formrow" hx-post="/config/default-webhook" hx-target="#config-feeds" hx-swap="outerHTML">
					<input class="field" type="url" name="webhook_url" value={ p.DefaultWebhook } placeholder="https://discord.com/api/webhooks/…" size="48"/>
					<button class="btn" type="submit">Save default</button>
				</form>
			} else {
				if p.DefaultWebhook == "" {
					<p class="muted">No default set.</p>
				} else {
					<p><code>{ p.DefaultWebhook }</code></p>
				}
			}
			<details open>
				<summary class="subhead">Feeds in config ({ itoa(len(p.ConfigFeeds)) })</summary>
				@ConfigTable(p)
			</details>
			if p.IsAdmin {
				<h3 class="subhead">Add feed</h3>
				<form class="formrow" hx-post="/config/feeds" hx-target="#config-feeds" hx-swap="outerHTML">
					<input class="field" type="url" name="url" placeholder="https://example.com/feed.xml" required size="40"/>
					<input class="field" type="url" name="webhook_url" placeholder="override webhook (optional)" size="40"/>
					<button class="btn" type="submit">Add</button>
				</form>
				<h3 class="subhead">Import OPML</h3>
				<form class="formrow" hx-post="/config/import" hx-target="#config-import-preview" hx-swap="outerHTML" hx-encoding="multipart/form-data" x-data="{ name: 'No file chosen' }">
					<label class="btn" for="opml-file">Choose file</label>
					<input id="opml-file" type="file" name="opml" accept=".opml,.xml,text/xml" required hidden x-on:change="name = $event.target.files.length ? $event.target.files[0].name : 'No file chosen'"/>
					<span class="muted" x-text="name" data-filename>No file chosen</span>
					<button class="btn" type="submit" hx-disabled-elt="this">Preview</button>
				</form>
				<div id="config-import-preview"></div>
			}
		}
	}
}

// ConfigTable is the managed feed list, re-rendered after every mutation.
templ ConfigTable(p ConfigParams) {
	<div id="config-feeds">
		<table class="ledger">
			<thead><tr><th>Feed</th><th>Webhook override</th><th></th></tr></thead>
			<tbody>
				for _, f := range p.ConfigFeeds {
					<tr>
						<td><code>{ f.URL }</code></td>
						<td>
							if f.WebhookURL == "" {
								<span class="muted">default</span>
							} else {
								<code>{ f.WebhookURL }</code>
							}
						</td>
						<td>
							if p.IsAdmin {
								<button
									class="btn danger"
									hx-delete={ "/config/feeds?url=" + f.URL }
									hx-target="#config-feeds"
									hx-swap="outerHTML"
									hx-confirm={ "Remove " + f.URL + "?" }
								>Remove</button>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// ConfigImportPreview renders an OPML import preview: what confirm
// would add, what is already configured, and what failed validation.
// Confirm posts the new URLs back to /config/import/confirm, which
// returns the refreshed ConfigTable like every other mutation.
templ ConfigImportPreview(p ImportPreview) {
	<div id="config-import-preview">
		<p>
			<strong>{ itoa(len(p.New)) } new</strong>, { itoa(len(p.Existing)) } already configured,
			{ itoa(len(p.Invalid)) } invalid.
		</p>
		if len(p.New) > 0 {
			<form hx-post="/config/import/confirm" hx-target="#config-feeds" hx-swap="outerHTML">
				<table class="ledger">
					<thead><tr><th></th><th>Feed</th><th>Title</th></tr></thead>
					<tbody>
						for _, f := range p.New {
							<tr>
								<td><input type="checkbox" name="url" value={ f.URL } checked/></td>
								<td><code>{ f.URL }</code></td>
								<td>{ f.Title }</td>
							</tr>
						}
					</tbody>
				</table>
				<button class="btn" type="submit" hx-disabled-elt="this">Import selected</button>
			</form>
		}
		if len(p.Existing) > 0 {
			<details>
				<summary>Already configured ({ itoa(len(p.Existing)) })</summary>
				<ul>
					for _, u := range p.Existing {
						<li><code>{ u }</code></li>
					}
				</ul>
			</details>
		}
		if len(p.Invalid) > 0 {
			<details>
				<summary>Invalid, skipped ({ itoa(len(p.Invalid)) })</summary>
				<ul>
					for _, u := range p.Invalid {
						<li><code>{ u }</code></li>
					}
				</ul>
			</details>
		}
	</div>
}
